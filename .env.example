# NEXUS AUTO V3 — Template variables d'environnement
# ─────────────────────────────────────────────────────────────────────────────
# Ce fichier est commité dans git. NE PAS y mettre de vraies clés.
#
# Usage :
#   cp .env.example .env
#   # puis éditer .env avec vos vraies clés

# Clé API Gemini (génération de scripts via Gemini headless)
GEMINI_API_KEY=your_gemini_api_key_here

# Clé API ElevenLabs (synthèse vocale TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Lien d'affiliation (optionnel — injecté dans les descriptions de vidéos)
# AFFILIATE_LINK=https://votre-lien-affiliation.com
